{
  "name": "yala",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:online": "node tools/build-online.mjs",
    "test": "node --test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-yala \"node --test tools/firestore-check.mjs\"",
    "test:online": "npm run build:online -- --emulator && firebase emulators:exec --only auth,firestore --project demo-yala \"node --test tools/firestore-check.mjs && node --test tools/browser-check.mjs\""
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.37.0",
    "playwright": "1.65.1"
  }
}
