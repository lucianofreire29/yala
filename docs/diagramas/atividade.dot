digraph YALA {
  graph [bgcolor="white", fontname="DejaVu Sans", label="YALA 1.0 — Descoberta, amizade e conversa", labelloc=t, pad=0.2, nodesep=0.35, ranksep=0.34];
  node [fontname="DejaVu Sans", shape=box, style="rounded,filled", fillcolor="#edf7f1", color="#285747"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#285747"];
  inicio [shape=circle, fixedsize=true, width=0.16, label="", fillcolor="#285747"];
  acesso [label="Entrar no YALA"];
  perfil [shape=diamond, label="Perfil completo?"];
  salvar [label="Preencher e salvar perfil"];
  explorar [label="Buscar estudante em Explorar"];
  escolher [shape=diamond, label="Qual ação?"];
  convidar [label="Enviar convite"];
  receber [label="Destinatário consulta convites em Amigos"];
  aceitou [shape=diamond, label="Destinatário aceitou?"];
  pendente [label="Convite permanece pendente"];
  amigos [label="Ambos aparecem em Meus amigos"];
  abrir [label="Abrir tela de conversa"];
  enviar [label="Enviar mensagem"];
  ler [label="Destinatário abre ou atualiza o histórico"];
  excluir [shape=diamond, label="Excluir meu histórico?"];
  ocultar [label="Remover acesso às mensagens\nanteriores para a conta solicitante"];
  fim [shape=doublecircle, fixedsize=true, width=0.22, label="", fillcolor="#285747"];
  inicio -> acesso -> perfil;
  perfil -> salvar [label="Não"];
  perfil -> explorar [label="Sim"];
  salvar -> explorar -> escolher;
  escolher -> convidar [label="Convidar"];
  escolher -> abrir [label="Conversar"];
  convidar -> receber -> aceitou;
  aceitou -> pendente [label="Ainda não"];
  aceitou -> amigos [label="Sim"];
  amigos -> fim;
  pendente -> fim;
  abrir -> enviar -> ler -> excluir;
  excluir -> ocultar [label="Confirmar"];
  excluir -> fim [label="Não"];
  ocultar -> fim;
  {rank=same; convidar; abrir;}
  {rank=same; receber; enviar;}
  {rank=same; aceitou; ler;}
}
