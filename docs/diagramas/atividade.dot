digraph YALA {
  graph [bgcolor="white", fontname="DejaVu Sans", label="YALA 1.0 — Descoberta de colega e troca de mensagens", labelloc=t, pad=0.2];
  node [fontname="DejaVu Sans", shape=box, style="rounded,filled", fillcolor="#edf7f1", color="#285747"];
  edge [fontname="DejaVu Sans", color="#285747"];
  inicio [shape=circle, fixedsize=true, width=0.20, label="", fillcolor="#285747"];
  acesso [label="Criar conta ou entrar"];
  autenticado [shape=diamond, label="Sessão válida?"];
  corrigir [label="Exibir erro e corrigir dados"];
  tem_perfil [shape=diamond, label="Perfil preenchido?"];
  salvar [label="Preencher e salvar perfil"];
  buscar [label="Consultar diretório e aplicar filtros"];
  encontrou [shape=diamond, label="Encontrou um colega?"];
  ajustar [label="Ajustar filtros ou voltar depois"];
  abrir [label="Abrir conversa e consultar histórico"];
  escrever [label="Escrever e enviar mensagem"];
  valida [shape=diamond, label="Mensagem aceita?"];
  erro [label="Exibir erro e corrigir a mensagem"];
  registrar [label="Registrar mensagem no banco"];
  destinatario [label="Destinatário abre ou atualiza a conversa"];
  responder [label="Destinatário lê e pode responder"];
  fim [shape=doublecircle, fixedsize=true, width=0.25, label="", fillcolor="#285747"];
  inicio -> acesso -> autenticado;
  autenticado -> corrigir [label="Não"];
  corrigir -> acesso;
  autenticado -> tem_perfil [label="Sim"];
  tem_perfil -> salvar [label="Não"];
  salvar -> buscar;
  tem_perfil -> buscar [label="Sim"];
  buscar -> encontrou;
  encontrou -> ajustar [label="Não"];
  ajustar -> buscar [label="Tentar novamente"];
  ajustar -> fim [label="Encerrar"];
  encontrou -> abrir [label="Sim"];
  abrir -> escrever -> valida;
  valida -> erro [label="Não"];
  erro -> escrever;
  valida -> registrar [label="Sim"];
  registrar -> destinatario -> responder -> fim;
}
